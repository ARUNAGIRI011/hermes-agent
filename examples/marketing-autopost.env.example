# Template only — never put real credentials in this file.
# Keep real credentials in a secret manager or local untracked environment file.

# Hermes / Google Gemini
GOOGLE_API_KEY=

# Meta (Instagram/Facebook) — app setup and permission review required
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# LinkedIn — official API OAuth credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# YouTube Data API — OAuth client and secure refresh-token storage
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# TikTok Content Posting API — app review and user authorization required
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# Publishing defaults; not a live scheduler configuration
MARKETING_TIMEZONE=Asia/Kolkata
MARKETING_AUTO_PUBLISH_ENABLED=false
MARKETING_MAX_POSTS_PER_PLATFORM_PER_DAY=3
MARKETING_PAUSE_ALL_PUBLISHING=true
